{
  "name": "dsh-vst-sandbox-pack",
  "version": "1.1.0",
  "description": "DSH 的「沙箱执行器」模式：提示词以 user 消息注入，兼容会丢弃 system 字段的 API 中转站。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./prompt-inject": "./lib/prompt-inject.js",
    "./prompt.md": "./prompt.md",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/prompt-inject.js",
    "prompt.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
